{
  "name": "explorer-launcher",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "ready": "vp run typegen && vp check && vp run check:contrast && vp run knip && vp test && vp run test:e2e && vp run -r build && vp run check:bundle",
    "prepare": "vp config",
    "typegen": "vpx scripts/typegen.ts",
    "check:contrast": "vpx scripts/check-contrast.ts",
    "check:bundle": "vp run --filter @explorer-launcher/desktop check:bundle",
    "package:desktop": "vp run --filter @explorer-launcher/desktop package",
    "test:e2e": "vp run --filter @explorer-launcher/desktop test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@explorer-launcher/config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
