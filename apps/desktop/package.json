{
  "name": "@explorer-launcher/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "vp build --config vite.main.config.ts && vp build --config vite.preload.config.ts",
    "package": "vp run --filter @explorer-launcher/web build && node scripts/copy-renderer.ts && vp run build && electron-builder --config electron-builder.yml",
    "dev": "vp run build && node scripts/dev.ts"
  },
  "devDependencies": {
    "@explorer-launcher/config": "workspace:*",
    "@explorer-launcher/electron": "workspace:*",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "es-toolkit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
